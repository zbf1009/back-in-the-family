{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grudge_v1.json",
  "title": "grudge_v1: who holds a grudge against whom",
  "description": "One item per directed grudge. A pair with no grudge is omitted (absence means level none). Identity fields for the shuffle comparison: from, to, level.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "items"],
  "properties": {
    "schema": {"const": "grudge_v1"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "level", "evidence", "reason"],
        "properties": {
          "from": {"type": "integer", "description": "Person who holds the grudge."},
          "to": {"type": "integer", "description": "Person the grudge is against."},
          "level": {"enum": ["low", "medium", "high"]},
          "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^e[0-9]{1,4}$"}},
          "reason": {"type": "string", "description": "Free text for presentation only. Not scored."}
        }
      }
    }
  }
}
