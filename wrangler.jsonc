{
  "name": "back-in-the-family-decision",
  "main": "./worker.js",
  "no_bundle": true,
  "compatibility_date": "2026-11-10",
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI",
    "remote": false
  },
  "vars": {
    "INFERENCE_ENABLED": "false",
    "MAX_REQUEST_BYTES": "16384"
  }
}
