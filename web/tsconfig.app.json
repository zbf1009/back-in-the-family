{
  // Main_Thread code (src/main), shared modules (src/shared) and App.svelte.
  // Checked with svelte-check (task 3.8).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // `vite/client` supplies the ambient `*?raw` module declaration used by
    // App.svelte to import fixtures/configs/pairwise.json as text (R3.1), and the
    // `window.__simHarness` typing added by src/main/harness.ts (DA-3).
    "types": ["vite/client"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/main/**/*.ts", "src/shared/**/*.ts", "src/main.ts", "src/**/*.svelte"]
}
