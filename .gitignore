# Rust
/target/
**/*.rs.bk

# Web / Node
node_modules/
dist/
*.log
# Vite bundle report written by web/vite.config.ts (outside dist)
web/.bundle-report.json
# Playwright Smoke_Test output (traces, screenshots); build output, never committed
web/test-results/

# wasm-pack output
/pkg/
**/pkg/

# Local environment and secrets
.env
.env.*
!.env.example
# A root `env` file (no dot) the author uses for the Cloudflare token; must never be committed
/env

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# NOTE: .kiro/ must stay tracked (hackathon requirement). Do not add it here.

# Wrangler local state (wrangler dev / deploy temp files)
.wrangler/
